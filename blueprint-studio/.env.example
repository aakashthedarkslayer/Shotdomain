# Required: password for the single admin account
ADMIN_PASSWORD=change-me
# Required: random string used to sign the session cookie (32+ chars)
SESSION_SECRET=replace-with-a-long-random-string

# Optional: enables the AI pass that finds client names, people and brands
# the dictionary and patterns miss. Without it, cleaning still runs.
ANTHROPIC_API_KEY=

# Optional: Figma personal access token (read access) for scanning Figma files
FIGMA_TOKEN=

# Optional: where uploads, cleaned files and the database live (default ./data)
DATA_DIR=
