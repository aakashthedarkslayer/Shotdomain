# Copy to .env.local and fill in. Leave the AUTH_GOOGLE_* values empty to run
# in local mode with no sign-in.

# Random secret that signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: restrict who can sign up. Comma-separated emails and/or @domains.
# Empty = any verified Google account.
AUTH_ALLOWED_EMAILS=

# Required when hosting anywhere other than Vercel/localhost (Railway, Render, Fly, VPS).
# AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Payments (Paddle). Leave empty to run without billing: every feature is then
# available to everyone. Needs Google sign-in above. See README → Payments.
# ---------------------------------------------------------------------------
# sandbox (test cards, sandbox-vendors.paddle.com) or production
PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication: an API key (server only, secret)
PADDLE_API_KEY=
# Paddle → Developer tools → Authentication: a client-side token (public, starts with test_ or live_)
PADDLE_CLIENT_TOKEN=
# Paddle → Developer tools → Notifications: the destination's secret key
PADDLE_WEBHOOK_SECRET=
# Paddle → Catalog → Products: price IDs (pri_...)
PADDLE_PRICE_STUDIO_MONTH=
PADDLE_PRICE_STUDIO_YEAR=
PADDLE_PRICE_AGENCY_MONTH=
PADDLE_PRICE_AGENCY_YEAR=
PADDLE_PRICE_LIFETIME=
