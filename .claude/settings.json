{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/premium-ui/scripts/device-privacy-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Artifact|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/premium-ui/scripts/premium-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/premium-ui/scripts/ui-lint.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
